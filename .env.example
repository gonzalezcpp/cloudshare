# Database (required - use Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (required)
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-strong-random-secret-min-32-chars"

# AWS S3 or S3-compatible storage (required for file uploads)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="your-bucket-name"
S3_ENDPOINT="https://your-s3-endpoint.amazonaws.com"
