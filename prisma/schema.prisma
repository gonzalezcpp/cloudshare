generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  email            String    @unique
  passwordHash     String    @map("password_hash")
  image            String?
  authProvider     String    @default("credentials") @map("auth_provider")
  needsOnboarding  Boolean   @default(false) @map("needs_onboarding")
  plan             String    @default("free")
  stripeCustomerId String?   @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  subscriptionStatus String? @map("subscription_status")
  lastIp           String?   @map("last_ip")
  lastHostname     String?   @map("last_hostname")
  lastCity         String?   @map("last_city")
  lastCountry      String?   @map("last_country")
  lastIsp          String?   @map("last_isp")
  lastLoginAt      DateTime? @map("last_login_at")
  storageUsed      BigInt    @default(0) @map("storage_used")
  storageLimit     BigInt    @default(10737418240) @map("storage_limit")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  files         File[]
  folders       Folder[]
  shareLinks    ShareLink[]
  downloads     DownloadHistory[]
  loginHistory  LoginHistory[]
  devices       DeviceInfo[]
  activity      UserActivity[]

  @@map("users")
}

model VerificationCode {
  id            String    @id @default(cuid())
  email         String
  code          String
  expiresAt     DateTime  @map("expires_at")
  used          Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("verification_codes")
}

model File {
  id            String    @id @default(cuid())
  ownerId       String    @map("owner_id")
  filename      String
  originalName  String    @map("original_name")
  storagePath   String    @unique @map("storage_path")
  fileData      Bytes?    @map("file_data")
  size          BigInt
  mimeType      String    @map("mime_type")
  folderId      String?   @map("folder_id")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shareLinks    ShareLink[]
  downloads     DownloadHistory[]

  @@map("files")
}

model Folder {
  id            String    @id @default(cuid())
  ownerId       String    @map("owner_id")
  name          String
  parentId      String?   @map("parent_id")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent        Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Folder[]  @relation("FolderHierarchy")
  files         File[]
  shareLinks    ShareLink[]

  @@map("folders")
}

model ShareLink {
  id            String    @id @default(cuid())
  fileId        String?   @map("file_id")
  folderId      String?   @map("folder_id")
  destinationUrl String?  @map("destination_url")
  ownerId       String    @map("owner_id")
  shareToken    String    @unique @map("share_token")
  pinProtected  Boolean   @default(false) @map("pin_protected")
  pinHash       String?   @map("pin_hash")
  isActive      Boolean   @default(true) @map("is_active")
  downloadCount Int       @default(0) @map("download_count")
  maxDownloads  Int?      @map("max_downloads")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  file          File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  attempts      PinAttempt[]
  visits        ShareVisit[]

  @@map("share_links")
}

model PinAttempt {
  id            String    @id @default(cuid())
  shareLinkId   String    @map("share_link_id")
  ipAddress     String    @map("ip_address")
  success       Boolean
  createdAt     DateTime  @default(now()) @map("created_at")

  shareLink     ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@map("pin_attempts")
}

model LoginHistory {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  event         String    @default("login")
  ipAddress     String?   @map("ip_address")
  hostname      String?
  city          String?
  region        String?
  country       String?
  postal        String?
  latitude      Float?
  longitude     Float?
  ipTimezone    String?   @map("ip_timezone")
  asn           String?
  isp           String?
  language      String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model FailedLogin {
  id            String    @id @default(cuid())
  email         String?
  userId        String?   @map("user_id")
  reason        String
  ipAddress     String?   @map("ip_address")
  hostname      String?
  city          String?
  country       String?
  isp           String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("failed_logins")
}

model ShareVisit {
  id            String    @id @default(cuid())
  shareLinkId   String    @map("share_link_id")
  ipAddress     String?   @map("ip_address")
  hostname      String?
  city          String?
  country       String?
  isp           String?
  success       Boolean   @default(false)
  code          String?
  createdAt     DateTime  @default(now()) @map("created_at")

  shareLink     ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId])
  @@map("share_visits")
}

model UserActivity {
  id            String    @id @default(cuid())
  userId        String?   @map("user_id")
  eventType     String    @map("event_type")
  resource      String?
  resourceName  String?   @map("resource_name")
  ip            String?
  userAgent     String?   @map("user_agent")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("user_activity")
}

model DeviceInfo {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  os            String?
  osVersion     String?   @map("os_version")
  arch          String?
  browser       String?
  cpuCores      Int?      @map("cpu_cores")
  ramGb         Float?    @map("ram_gb")
  gpu           String?
  gpuFamily     String?   @map("gpu_family")
  webglVendor   String?   @map("webgl_vendor")
  canvasHash    String?   @map("canvas_hash")
  pixelRatio    Float?    @map("pixel_ratio")
  touch         Boolean?
  darkMode      Boolean?  @map("dark_mode")
  netType       String?   @map("net_type")
  saveData      Boolean?  @map("save_data")
  screen        String?
  timezone      String?
  language      String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_info")
}

model DownloadHistory {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  fileId        String    @map("file_id")
  fileName      String    @map("file_name")
  fileSize      BigInt    @map("file_size")
  shareLinkId   String?   @map("share_link_id")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")

  owner         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  file          File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("download_history")
}
